# Whole-project repository for the Ceylon / Sri Lanka history work.
# Everything at the top level is ignored unless listed here, because this folder also holds scans, PDFs and
# third-party material that must not be published (see SOURCES.md).
/*
!/.gitignore
!/README.md
!/SOURCES.md
!/spine/
!/docs/
!/export_atlas.py
!/geography/

.openai/
__pycache__/
*.pyc

# geography/: the GIS database, its build scripts and input tables are published; the georeferenced scans
# (too large for GitHub, and rebuilt from the sources named in each folder) and scratch arrays are not.
/geography/**/*.tif
/geography/**/*.aux.xml
/geography/**/*.npy
!/geography/motor-map-1936/ceylon-motor-map-1936.tif
!/geography/ferguson-1893/ferguson-1893.jpeg.tif
/geography/elevation/
/geography/historical-gis/headmen_1934_work/full-*.png
/geography/historical-gis/headmen_1934_work/p[0-9]*.png
